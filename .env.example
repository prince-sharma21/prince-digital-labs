# Copy this file to .env and fill in real values.
# .env is in .gitignore — never commit real secrets.

NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000

# ---- Database (PostgreSQL — e.g. Neon, free forever) ----
# Get this from your Neon project: Connect -> Drivers -> copy the string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- Sessions ----
SESSION_TTL_HOURS=72

# ---- First owner/admin account ----
# Used ONLY by `npm run seed`, and only if no owner account exists yet.
# Choose a real password (10+ characters) before running seed. Never
# commit this file with real values.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Email (optional — leave blank until you have an SMTP provider) ----
# Needed for: password-reset emails, new-lead notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Analytics / Ads (optional) ----
# Leave blank until you have real IDs — the site never injects tracking
# scripts for an empty ID.
GA_MEASUREMENT_ID=
META_PIXEL_ID=
GOOGLE_ADS_CONVERSION_ID=
